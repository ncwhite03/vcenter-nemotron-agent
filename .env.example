WEBUI_SECRET_KEY=replace-with-a-long-random-string

# NVIDIA NIM (hosted Nemotron) - create a key at https://build.nvidia.com
NVIDIA_NIM_API_KEY=
OPENAI_API_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional fallback vCenter config (single line JSON). Prefer setting the tool's VCENTERS valve in the UI.
VCENTERS_JSON={"prod":{"host":"vcenter-prod.example.local","user":"svc-agent@vsphere.local","password":"CHANGE_ME","port":443,"verify_ssl":false}}
